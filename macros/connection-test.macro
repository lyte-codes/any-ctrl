# Run this first, on the HOME screen, to prove the whole chain works:
# buttons, the d-pad and both sticks. Nothing here changes a setting or
# deletes anything - it only moves the cursor around.

meta name "Connection test"
meta description "Move the HOME cursor and wiggle both sticks"

include "lib/common.macro"

log "d-pad: right, right, left, left"
dpad right 200ms
wait 300ms
dpad right 200ms
wait 300ms
dpad left 200ms
wait 300ms
dpad left 200ms
wait 500ms

log "left stick: a full circle"
call stick_circle
wait 500ms

log "right stick: a full circle"
stick R angle 0 1.0 for 250ms
stick R angle 90 1.0 for 250ms
stick R angle 180 1.0 for 250ms
stick R angle 270 1.0 for 250ms
stick R center
wait 500ms

log "shoulder buttons"
press L 100ms
press R 100ms
press ZL+ZR 200ms

log "done - if the cursor moved, the connection is good"
